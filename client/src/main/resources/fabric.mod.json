  "authors": [
    "镐京方块协会"
  ],
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.haojing.battlepass.client.HaoJingBattlePassClient"
    ]
  },
  "mixins": [
    "haojing_battlepass.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.1",
    "fabric-api": "*",
    "minecraft": "~1.21.11",
    "java": ">=21"
  }
}
